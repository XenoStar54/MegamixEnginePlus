<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>sprCustomSpawner</spriteName>
  <solid>0</solid>
  <visible>0</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>prtEntity</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Custom Spawners are very versatile. They can be set to spawn virtually anything, and with strange use, can even
// just be used as objects that execute a script every frame. Their purpose should be fairly self explanatory.


despawnRange = -1;

event_inherited();

respawn = true;

healthpointsStart = 1;
healthpoints = healthpointsStart;
contactDamage = 0;

blockCollision = 0;
grav = 0;

// Enemy specific code

//@cc The object to spawn.
object = objLifeEnergyBig;

//@cc How long until the spawner starts spawning objects normally.
startWait = 0;

//@cc The wait time between each object spawn.
spawnWait = 480;
timer = 0;

//@cc The limit to how many of the object the spawner can spawn. 0 = infinite (default: 0)
limit = 0;

//@cc whether to only count objects this spawner created for the limit. (default: false)
countOwn = false;

//@cc The Game Maker script to execute within the object. If you put, say, xspeed = -3 in your script called scrMySpawner,
// and the object is set to objEnemyBullet, then the spawner will create a bullet moving left. (This is an alternative to the code variable above,
// and is more reliable since GML code execution from a string is not fully-featured.)
script = scrNoEffect;

//@cc number of arguments
scriptArgC = 0;

//@cc array containing arguments (will be cropped to `scriptArgC`)
scriptArgV = makeArray(0);

//@cc string containing GML code to execute. If you put, say, code = "xspeed = -3" and the object is set to objEnemyBullet,
// then the spawner will create a bullet moving left.
code = "";

//@cc object should be shifted horizontally to the nearest screen left/right edge when it is created?
shiftEdgeHorizontal = false;

//@cc object should be shifted vertically to the nearest screen top/bottom edge when it is created?
shiftEdgeVertical = false;

//@cc should object spawn on target's x coordinate; this overwrites shiftEdgeHorizontal
followTargetX = false;

//@cc should object spawn on target's x coordinate; this overwrites shiftEdgeVertical
followTargetY = false;

//@cc if 1, the spawner will attach itself to the right screen edge, and if -1, to the left edge
followScreenEdgeX = 0;

//@cc if 1, the spawner will attach itself to the bottom screen edge, and if -1, to the top edge
followScreenEdgeY = 0;

//@cc if 1, the spawner will spawn the object at the screen edge the player is looking at
// if -1, at the edge the player isn't looking at; ignores shiftEdgeHorizontal
spawnOnScreenEdgeLookedAtX = 0;

//@cc offset the spawned object
// aside for shiftEdgeHorizontal and shiftEdgeVertical, spawner will try to spawn
// objects in its center; this can be used to correct spawning position without
// needing to move the spawner; this also works with followTargetX and Y
spawnOffsetX = 0;
spawnOffsetY = 0;

//@cc the spawner's activation method
activeMethod = 'A';
// A - active if spawner is alive
// V - active if target is vertically alligned with the spawner
// H - active if target is horizontally alligned with the spawner
// UP - active if target is vertically alligned with and above the spawner
// DOWN - active if target is vertically alligned with and below the spawner
// LEFT - active if target is horizontally alligned with and to the left of the spawner
// RIGHT - active if target is horizontally alligned with and to the right of the spawner
// IN - active if target is inside the spawner
// you can stretch the spawner's hitbox to make detection easier

// size of the spawned object list
spawnN = 0;

// number of spawned objects still alive
spawnedCount = 0;

alarm[0] = 1;
spawnList = makeArray();
canHit = false;
image_speed = 0;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

if (entityCanStep())
{
    timer -= 1;
    
    if(followScreenEdgeX != 0) x = (bboxGetXCenter()-x) + view_xview + view_wview*(followScreenEdgeX &gt; 0);
    if(followScreenEdgeY != 0) y = (bboxGetYCenter()-y) + view_yview + view_hview*(followScreenEdgeY &gt; 0);
    
    // if counting own spawns, check if any have died:
    if (countOwn)
    {
        var atEnd = true;
        for (var i = spawnN - 1; i &gt;= 0; i--)
        {
            if (atEnd &amp;&amp; spawnList[i] == noone)
            {
                spawnN--;
            }
            else
            {
                if (!instance_exists(spawnList[i]))
                {
                    spawnList[i] = noone;
                    if (atEnd)
                        spawnN--;
                    spawnedCount--;
                }
                else
                    atEnd = false;
            }
        }
    }
    
    // attempt to spawn an object:
    if (timer &lt;= 0)
    {
        // reset timer
        timer = spawnWait;
        
        // determine if constraints allow us to spawn an object:
        var allowSpawn = false;
        if (limit == 0)
            allowSpawn = true;
        else if (!countOwn &amp;&amp; instance_number(object) &lt; limit)
            allowSpawn = true;
        else if (countOwn &amp;&amp; spawnedCount &lt; limit)
            allowSpawn = true;
        
        // detection check
        var detectionCheck = 0;
        switch(activeMethod)
        {
            case 'A':
                detectionCheck = 1;
                break;
            case 'V':
                with(objMegaman) with(other)
                {
                    if(place_meeting(x,other.y,other)) detectionCheck = 1;
                }
                break;
            case 'H':
                with(objMegaman) with(other)
                {
                    if(place_meeting(other.x,y,other)) detectionCheck = 1;
                }
                break;
            case 'UP':
                with(objMegaman) with(other)
                {
                    if(place_meeting(x,other.y,other) &amp;&amp; bbox_bottom &lt;= other.bbox_bottom) detectionCheck = 1;
                }
                break;
            case 'DOWN':
                with(objMegaman) with(other)
                {
                    if(place_meeting(x,other.y,other) &amp;&amp; bbox_top &gt;= other.bbox_top) detectionCheck = 1;
                }
                break;
            case 'LEFT':
                with(objMegaman) with(other)
                {
                    if(place_meeting(other.x,y,other) &amp;&amp; bbox_right &lt;= other.bbox_right) detectionCheck = 1;
                }
                break;
            case 'RIGHT':
                with(objMegaman) with(other)
                {
                    if(place_meeting(other.x,y,other) &amp;&amp; bbox_left &gt;= other.bbox_left) detectionCheck = 1;
                }
                break;
            case 'IN':
                with(objMegaman) with(other)
                {
                    if(place_meeting(x,y,other)) detectionCheck = 1;
                }
                break;
        }
        
        if (allowSpawn &amp;&amp; detectionCheck)
        {
            // spawn the object:
            var obj = instance_create(bboxGetXCenter()+spawnOffsetX, bboxGetYCenter()+spawnOffsetY, object);
            
            // keep tally if counting own:
            if (countOwn)
            {
                spawnList[spawnN++] = obj;
                spawnedCount++;
            }
            
            // setup spawned object by running custom code:
            with (obj)
            {
                // shift horizontally/vertically if necessary:
                if (other.shiftEdgeHorizontal)
                {
                    x = arrayNearest(
                        makeArray(view_xview[0] - (bbox_right - x) + 1,
                        view_xview[0] + view_wview[0] + (x - bbox_left) - 1),
                        x);
                }
                if (other.shiftEdgeVertical)
                {
                    y = arrayNearest(
                        makeArray(view_yview[0] - (bbox_bottom - y) + 1,
                        view_yview[0] + view_hview[0] + (y - bbox_top) - 1),
                        y);
                }
                if(other.followTargetX)
                {
                    if(other.target) x = other.target.x + other.spawnOffsetX;
                }
                if(other.followTargetY)
                {
                    if(other.target) y = other.target.y + other.spawnOffsetY;
                }
                if(other.spawnOnScreenEdgeLookedAtX != 0)
                {
                    if(other.target)
                    {
                        var _dir = sign(other.target.image_xscale) * sign(other.spawnOnScreenEdgeLookedAtX);
                        
                        x = (view_xview[0] + view_wview[0] + (x - bbox_left) - 1)*(_dir == 1)
                            + (view_xview[0] - (bbox_right - x) + 1)*(_dir == -1);
                    }
                }
                
                // setup
                respawn = false;
                scriptExecuteNargs(other.script, other.scriptArgV, other.scriptArgC);
                
                if (other.code != "")
                    stringExecutePartial(other.code);
            }
        }
    }
}
else if (dead)
{
    timer = startWait;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="4">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
