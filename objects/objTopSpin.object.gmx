if(instance_exists(other) &amp;&amp; instance_exists(parent))
{
    var bounce = false;
    if(parent.gravDir &gt; 0) // right side up
    {
        if((bbox_bottom - y + prevY) &lt; bboxGetYCenterObject(other)) bounce = true;
    }
    else // upside down
    {
        if((bbox_top - y + prevY) &gt; bboxGetYCenterObject(other)) bounce = true;
    }
    
    if(bounce &amp;&amp; bounceForce != 0)
    {
        var gravityCheck = 0;
        with(parent) gravityCheck = playerIsLocked(PL_LOCK_GRAVITY);
        if(!ground &amp;&amp; !climbing &amp;&amp; !gravityCheck)
        {
            parent.yspeed = -parent.gravDir*bounceForce;
            parent.canMinJump = false;
        }
    }
}
