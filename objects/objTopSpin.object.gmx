        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.damage != 0)
{
    if (global.ammo[playerID, global.weapon[playerID]] &gt; 0)
    {
        global.ammo[playerID, global.weapon[playerID]] -= (consumeAmmoOnHit / (global.energySaver + 1));
    }
}

if(instance_exists(other) &amp;&amp; instance_exists(parent))
{
    var bounce = false;
    if(parent.gravDir &gt; 0) // right side up
    {
        if((bbox_bottom - prevY+y) &lt; bboxGetYCenterObject(other)) bounce = true;
    }
    else // upside down
    {
        if((bbox_top - prevY+y) &gt; bboxGetYCenterObject(other)) bounce = true;
    }
    
    if(bounce &amp;&amp; bounceForce != 0)
    {
        var gravityCheck = 0;
        with(parent) gravityCheck = playerIsLocked(PL_LOCK_GRAVITY);
        if(!ground &amp;&amp; !climbing &amp;&amp; !gravityCheck)
        {
            parent.yspeed = -parent.gravDir*bounceForce;
            parent.canMinJump = false;
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
