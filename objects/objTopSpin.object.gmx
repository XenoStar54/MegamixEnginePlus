    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

bulletLimitCost = 1;

contactDamage = 3;
inWater = -1;

penetrate = 3; // obviously we don't want to destroy the control for the dash
pierces = 2;
attackDelay = 16;

playSFX(sfxTopSpin); // needs its own sfx later

animTimer = 0;
animFrame = 0;

shiftVisible = 2;
despawnRange = -1;
topLock = 0;
jumpLock = 0;

performBounce = 0;

spinTime = 0;
spinTimeMax = 30;

forceFullJump = 0; // if variable jump height is disabled on use

usedOnGround = 0;
usedOnLadder = 0;

prevY = y;

groundForceMoveOnUse = 1; // when 1, if used on the ground, stuck to direction
groundForceDir = 0; // don't use
groundAccel = -1; // if negative or 0, player slide speed accel
groundTopSpeed = 2.5; // if negative or 0, infinite speed

ladderForceStopOnUse = 1; // when 1, if used on ladder, stop movement

jumpCounterTracker = 0;
breakOnJump = 1;

hitboxXscale = 1;
hitboxYscale = 1;

struckEnemy = noone;

bounceForce = 5.25; // bounce off enemies; set to 0 to disable
spinTimeInfiniteWhenAerial = 1; // when 1, if used in the air, only ever stops if deleted

consumeAmmoOnHit = 0.5;
consumeAmmoOnReflect = 0.5;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

if (instance_exists(parent))
{
    if(topLock) topLock = lockPoolRelease(topLock);
    if(jumpLock) jumpLock = lockPoolRelease(jumpLock);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();

if (!global.frozen)
{
    // check for parent
    if (!instance_exists(parent))
    {
        instance_destroy();
        exit;
    }
    
    prevY = y;
    
    image_xscale = parent.image_xscale*hitboxXscale;
    image_yscale = parent.image_yscale*hitboxYscale;
    
    x = parent.x - (1); // stay attached to MM
    y = parent.y - (1);
    
    // special new movement
    if(parent.ground &amp;&amp; usedOnGround &amp;&amp; !parent.isSlide)
    {
        // move on the ground
        if(groundForceMoveOnUse) // force movement with set speed of one accel
        {
            parent.xspeed = groundForceDir*groundAccel;
        }
        else
        {
            parent.xspeed += parent.xDir*groundAccel;
            if(abs(parent.xspeed) &gt; groundTopSpeed &amp;&amp; groundTopSpeed &gt; 0)
            {
                parent.xspeed = sign(parent.xspeed)*groundTopSpeed;
            }
        }
    }
    
    // stop movement on ladders
    if(parent.climbing &amp;&amp; usedOnLadder)
    {
        if(ladderForceStopOnUse) parent.yspeed = 0;
    }
    
    // real anim
    animTimer += 1;
    if (animTimer == 3)
    {
        animFrame += 1;
        if (animFrame &gt;= 4)
        {
            animFrame = 0;
        }
        animTimer = 0;
    }
    
    // Mega Man anim + movement forcing
    with (parent)
    {
        playerHandleSprites("Top");
        
        iFrames = max(iFrames,5);
    }
    
    if(jumpLock &amp;&amp; global.keyJumpPressed[playerID])
    {
        with(parent)
        {
            if(jumpCounter &lt; jumpCounterMax)
            {
                playerJump();
                canMinJump = true;
            }
        }
    }
    
    if(!spinTimeInfiniteWhenAerial)
    {
        spinTime++;
    }
    
    // a lot of break free criteria alright
    if ((parent.ground xor usedOnGround) || (parent.climbing xor usedOnLadder)
        || (parent.jumpCounter != jumpCounterTracker &amp;&amp; breakOnJump)
        || (spinTime &gt; spinTimeMax) || parent.isHit || parent.isSlide)
    {
        instance_destroy();
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="prtEnemyProjectile">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// copypasted from jewel satellite
if (canDamage)
{
    var deduceAmmo = false;
    if (!global.factionStance[faction, other.faction])
    {
        exit;
    }
    
    switch (other.reflectable)
    {
        case 0:
            exit;
            break;
        case -1:
            playSFX(sfxEnemyHit);
            with (other)
            {
                instance_create(bboxGetXCenter(), bboxGetYCenter(), objExplosion);
                event_user(EV_DEATH);
            }
            deduceAmmo = true;
            break;
        case 1:
            playSFX(sfxEnemyHit);
            with (other)
            {
                faction = other.faction;
                xspeed *= -1;
                yspeed *= -1;
                hspeed *= -1;
                vspeed *= -1;
                direction += 180;
                image_xscale *= -1;
                pierces = 0;
                grav = 0;
                iFrames = 4;
            }
            deduceAmmo = true;
            break;
    }
    
    if(deduceAmmo)
    {
        if (global.ammo[playerID, global.weapon[playerID]] &gt; 0)
        {
            global.ammo[playerID, global.weapon[playerID]] -= (consumeAmmoOnReflect / (global.energySaver + 1));
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="24">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.keyShootPressed[playerID] &amp;&amp; !playerIsLocked(PL_LOCK_SHOOT)
    &amp;&amp; global.ammo[playerID, global.weapon[playerID]] &gt; 0)
{
    var i = fireWeapon(0, 0, objTopSpin, 1, 0, 0, 0);
    with (i)
    {
        /*
        groundForceMoveOnUse = 0;
        groundAccel = 0.25;
        */
        var saveSpinTimeInfiniteWhenAerial = spinTimeInfiniteWhenAerial;
        spinTimeInfiniteWhenAerial = 0;
        if(other.ground) usedOnGround = 1;
        else if(other.climbing) usedOnLadder = 1;
        else
        {
            spinTimeInfiniteWhenAerial = saveSpinTimeInfiniteWhenAerial;
            jumpLock = lockPoolLock(PL_LOCK_JUMP);
            jumpLock.targetInstance = other.id;
        }
        
        if(usedOnGround)
        {
            topLock = lockPoolLock(PL_LOCK_MOVE);
            topLock.targetInstance = other.id;
            if(groundAccel &lt;= 0) groundAccel = other.slideSpeed;
            with(other)
            {
                xspeed = xDir*other.groundAccel;
            }
            groundForceDir = other.xDir;
        }
        
        if(forceFullJump) other.canMinJump = false;
        
        jumpCounterTracker = other.jumpCounter;
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
