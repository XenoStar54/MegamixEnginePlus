        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!dead)
{
    if (drawBoss) // actually draw itself
    {
        if(isFight)
        {
            if ((iFrames mod 4 &lt; 2) || !iFrames) // itsa me
            {
                sprite_index = spriteNormal;
            }
            else // im hit
            {
                sprite_index = spriteHurt;
            }
        }
        drawSelf();
        if(sprite_index == spriteNormal || sprite_index == spriteHurt)
        {
            draw_sprite_ext(spriteGun,0,round(x+gunPosX*image_xscale),round(y+gunPosY*image_yscale),gunDir,image_yscale,image_angle,c_white,image_alpha);
        }
    }
}
</string>
          </argument>
        </arguments>
      </action>
